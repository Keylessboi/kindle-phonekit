# ===== PhoneKit dashboard configuration =====
# PK_DASH_NAME : short label shown at the top of the dashboard.
# PK_DASH_URL  : OPTIONAL external JSON data source (a URL your own home-lab
#                server exposes). Leave empty to show just the clock/date.
#                This server fetches it with stdlib urllib only.
PK_DASH_NAME="homelab"
PK_DASH_URL=""
PK_DASH_PORT="8084"