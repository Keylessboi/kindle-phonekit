# ===== PhoneKit LLM configuration =====
# Point at ANY OpenAI-compatible chat completions endpoint.
# Examples:
#   Ollama     http://127.0.0.1:11434/v1/chat/completions
#   llama.cpp  http://127.0.0.1:8080/v1/chat/completions
#   vLLM       http://server:8000/v1/chat/completions
#   OpenAI     https://api.openai.com/v1/chat/completions
#   OpenRouter https://openrouter.ai/api/v1/chat/completions
PK_LLM_API_URL="http://127.0.0.1:11434/v1/chat/completions"
PK_LLM_API_KEY=""
PK_LLM_MODEL="qwen2.5:7b-instruct"
PK_LLM_SYSTEM="You are a helpful assistant running on an e-ink Kindle. Keep answers short and skimmable."
PK_LLM_PORT="8080"