# ===== PhoneKit read-it-later configuration =====
# Local HTTP server port for the Kindle browser.
PK_RIL_PORT="8081"

# Optional summary feature. Leave PK_RIL_API_URL empty to hide the
# "Summarize" button entirely. Point at ANY OpenAI-compatible chat
# completions endpoint, for example:
#   Ollama     http://127.0.0.1:11434/v1/chat/completions
#   vLLM       http://server:8000/v1/chat/completions
#   OpenRouter https://openrouter.ai/api/v1/chat/completions
PK_RIL_API_URL=""
PK_RIL_API_KEY=""
PK_RIL_MODEL="qwen2.5:7b-instruct"