# ===== PhoneKit Notes + Todo configuration =====
# Port the notes server listens on for the Experimental Browser.
PK_NOTES_PORT="8083"

# Plaintext data file. Stored under /mnt/us so Notes and Todos survive a reboot
# and are visible on the Kindle user partition over USB. If this path is not
# writable at runtime, the server falls back to ./notes.txt next to the server.
PK_NOTES_FILE="/mnt/us/phonekit/notes.txt"