# ===== PhoneKit XMPP =====
# A Kindle cannot run Android apps, so the Monocles / Cheogram clients are
# served through the browser (they are both Android apps; their *web* ports
# are what runs here).
#
# Browser client options:
#   Cheogram WWW   https://app.cheogram.com   (needs an XMPP server with
#                                              websocket support; Snikket and
#                                              JMP work best)
#   Monocles Web   https://chat.monocles.de   (Movim-based, classic XMPP)
#   Movim           self-host it and put your URL here
PK_XMPP_URL="https://app.cheogram.com"

# The optional on-screen bridge (ext/xmpp/bridge.py) uses these. It connects
# directly to your XMPP server over TLS and flashes incoming messages on the
# e-ink screen. SCRAM-SHA-1 is used when offered.
PK_XMPP_JID=""
PK_XMPP_PASS=""
# Optional: override server host/port (default: JID domain, port 5222)
PK_XMPP_HOST=""
PK_XMPP_PORT="5222"
# Set to 1 to skip TLS certificate checks (self-signed servers). Insecure;
# don't leave this on for a real account.
PK_XMPP_NO_VERIFY="0"
# Set to 0 to silence the on-screen popup for incoming messages.
PK_XMPP_POPUP="1"
# Set to 1 for verbose debug logging to /tmp/phonekit_xmpp.log.
PK_XMPP_DEBUG="0"
# Where inbound messages are logged (default: /tmp/phonekit_xmpp.txt).
PK_XMPP_INBOX="/tmp/phonekit_xmpp.txt"